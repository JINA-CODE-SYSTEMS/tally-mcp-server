# === Deployment mode (#172) ===
# Written by scripts\setup-windows.ps1 (from source) and by the installer - leave these commented.
# The script works out the mode and preserves an existing box's: uncommenting DEPLOYMENT_MODE=local
# on a box that runs the remote service would have the next setup run remove that service.
# DEPLOYMENT_MODE=local      # 'local' (default): no service, no port, no OAuth password - the AI assistant
#                            # spawns dist\index.mjs over stdio. 'remote': NSSM service, dist\server.mjs.
# REMOTE_AUTH=oauth-password # remote only: 'oauth-password' | 'paired'
# REMOTE_TRANSPORT=tunnel    # remote only: 'tunnel' | 'lan'

# === Required (Cloud/Remote mode only) ===
PASSWORD=                    # OAuth authentication password (required for server.mts)

# === Tally Prime Connection ===
TALLY_HOST=localhost         # Tally Prime XML server hostname
TALLY_PORT=9000              # Tally Prime XML server port
TALLY_DATA_PATH=             # Tally Prime data directory (e.g. C:\Users\Public\TallyPrimeEditLog\data)
TALLY_EXE_PATH=              # Tally Prime executable (default: C:\Program Files\TallyPrime\tally.exe)
TALLY_COMPANY_USER=          # Tally company username (if security is enabled)
TALLY_COMPANY_PASSWORD=      # Tally company password (if security is enabled)

# === Server Configuration (Cloud/Remote mode only) ===
PORT=3000                    # HTTP server port
MCP_DOMAIN=http://localhost:3000  # Public-facing domain (used in OAuth URLs)
BIND_HOST=127.0.0.1          # Bind address (use 0.0.0.0 only behind reverse proxy)
CORS_ORIGINS=                # Comma-separated allowed origins (defaults to MCP_DOMAIN)
# TRUST_PROXY=               # Whose X-Forwarded-For header to believe for rate limiting. Leave unset when
                             # the tunnel / reverse proxy runs on THIS machine (the default trusts loopback
                             # only). Set 'false' if clients connect directly (LAN). If the reverse proxy
                             # is on another host, set its IP or CIDR (comma-separated), or a hop count.
                             # Never trust more than you must: a trusted peer chooses the client address.
# AUTH_BACKOFF_FREE_ATTEMPTS=5   # Wrong passwords (counted across ALL clients) before lockouts begin
# AUTH_BACKOFF_BASE_MS=1000      # First lockout; doubles on each further failure
# AUTH_BACKOFF_MAX_MS=60000      # Longest lockout. During a lockout sign-in returns 429 for everyone.

# === Security ===
ADMIN_SECRET=                # Secret for manual client registration (Authorization: Bearer ... on /register).
                             # By itself this does NOT close registration: Claude and VS Code register
                             # themselves with no credential (dynamic client registration), so /register
                             # stays open and the gate is PASSWORD on the sign-in page.
# REQUIRE_ADMIN_SECRET_FOR_REGISTRATION=true
                             # Uncomment to accept ONLY registrations carrying ADMIN_SECRET. Clients must
                             # then be registered by hand; with no ADMIN_SECRET set, registration is closed.
# OAUTH_MAX_CLIENTS=500      # Cap on registered clients. Idle ones (no live token) are dropped first.
# OAUTH_REDIRECT_SCHEMES=    # Extra app redirect schemes to accept at registration, comma-separated.
                             # Built in: vscode, vscode-insiders, cursor, claude. https:// and
                             # http://localhost / 127.0.0.1 are always accepted.
READONLY_MODE=false          # Set to 'true' to disable everything that can change Tally data: all write
                             # tools, free-form keystrokes (gui-send-keys), set-entry-order, and the raw
                             # XML probe debug tool as a whole. gui-screenshot and the fixed company-loading
                             # tools (load-company, switch-company, unlock-stored-credentials) stay on.
# ENTRY_ORDER=credit-first   # BLANKET fallback: 'credit-first' or 'debit-first'.
                             # Entry order is really PER VOUCHER TYPE - receipts, payments, sales and
                             # purchases are often expected to read differently - and those answers
                             # live in <TALLY_DATA_PATH>/.tally-mcp-entry-order.json, which takes
                             # precedence over this key.
                             # Purchase, Sales, Receipt and Payment already have built-in defaults
                             # (the party line leads, matching how Tally prompts), so they write
                             # without asking - the user is told which order was used and can change
                             # it. Any OTHER type with no answer is refused on write, and the user is
                             # asked about that type instead of us deciding for them.
                             # DELIBERATELY COMMENTED OUT: set this only to force one order onto
                             # every type at once, overriding the built-in defaults.
                             # Display only - Tally carries debit/credit in ISDEEMEDPOSITIVE and the
                             # sign of AMOUNT, never in line position, so the posting, the signs and
                             # the balance are identical either way.
UPDATE_CHECK=true            # The tray asks GitHub once a day whether a newer release exists and
                             # says so if there is one; "Check for updates..." in the tray and the
                             # check-for-updates tool ask on demand. They download and run NOTHING;
                             # installing is always a deliberate act by you. Set 'false' to stop them.
                             # These are the only outbound calls a local install makes: they send no data
                             # beyond the request itself, and never contacts anything but GitHub.
ENABLE_GUI_CONTROL=true      # Exposes gui-screenshot / gui-send-keys, which is how the AI assistant drives the
                             # Tally window: look at the screen, decide ONE step, look again. On by
                             # default because it is the only supervised path — with it off, the
                             # remaining GUI actions still inject keystrokes, just blind and with
                             # nothing able to see or clear a dialog left on screen.
                             # Set to 'false' on locked-down boxes that want only the XML tools.
                             # Note the real exposure: screenshots may include a credential field,
                             # and keystrokes go wherever Tally's focus is.
                             # With READONLY_MODE=true, gui-send-keys is refused (keystrokes can alter
                             # or delete vouchers); gui-screenshot keeps working.
