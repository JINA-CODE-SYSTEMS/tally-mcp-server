# === Required (Cloud/Remote mode only) ===
PASSWORD=                    # OAuth authentication password (required for server.mts)

# === Tally Prime Connection ===
TALLY_HOST=localhost         # Tally Prime XML server hostname
TALLY_PORT=9000              # Tally Prime XML server port
TALLY_DATA_PATH=             # Tally Prime data directory (e.g. C:\Users\Public\TallyPrimeEditLog\data)
TALLY_EXE_PATH=              # Tally Prime executable (default: C:\Program Files\TallyPrime\tally.exe)
TALLY_COMPANY_USER=          # Tally company username (if security is enabled)
TALLY_COMPANY_PASSWORD=      # Tally company password (if security is enabled)

# === Server Configuration (Cloud/Remote mode only) ===
PORT=3000                    # HTTP server port
MCP_DOMAIN=http://localhost:3000  # Public-facing domain (used in OAuth URLs)
BIND_HOST=127.0.0.1          # Bind address (use 0.0.0.0 only behind reverse proxy)
CORS_ORIGINS=                # Comma-separated allowed origins (defaults to MCP_DOMAIN)

# === Security ===
ADMIN_SECRET=                # Optional secret for manual client registration
READONLY_MODE=false          # Set to 'true' to disable all write tools
# ENTRY_ORDER=credit-first   # BLANKET fallback: 'credit-first' or 'debit-first'.
                             # Entry order is really PER VOUCHER TYPE - receipts, payments, sales and
                             # purchases are often expected to read differently - and those answers
                             # live in <TALLY_DATA_PATH>/.tally-mcp-entry-order.json, which takes
                             # precedence over this key.
                             # Purchase, Sales, Receipt and Payment already have built-in defaults
                             # (the party line leads, matching how Tally prompts), so they write
                             # without asking - the user is told which order was used and can change
                             # it. Any OTHER type with no answer is refused on write, and the user is
                             # asked about that type instead of us deciding for them.
                             # DELIBERATELY COMMENTED OUT: set this only to force one order onto
                             # every type at once, overriding the built-in defaults.
                             # Display only - Tally carries debit/credit in ISDEEMEDPOSITIVE and the
                             # sign of AMOUNT, never in line position, so the posting, the signs and
                             # the balance are identical either way.
UPDATE_CHECK=true            # The tray asks GitHub once a day whether a newer release exists and
                             # says so if there is one. It downloads and runs NOTHING; installing is
                             # always a deliberate act by you. Set 'false' to stop the check.
                             # This is the one outbound call a local install makes: it sends no data
                             # beyond the request itself, and never contacts anything but GitHub.
ENABLE_GUI_CONTROL=true      # Exposes gui-screenshot / gui-send-keys, which is how Claude drives the
                             # Tally window: look at the screen, decide ONE step, look again. On by
                             # default because it is the only supervised path — with it off, the
                             # remaining GUI actions still inject keystrokes, just blind and with
                             # nothing able to see or clear a dialog left on screen.
                             # Set to 'false' on locked-down boxes that want only the XML tools.
                             # Note the real exposure: screenshots may include a credential field,
                             # and keystrokes go wherever Tally's focus is.
